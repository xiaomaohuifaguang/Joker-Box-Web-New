{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "joker-box",
  "version": "0.1.0",
  "identifier": "com.jokerbox.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Joker Box",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzOEI3N0U4MERBQzk0ODEKUldTQmxLd042SGVMczRKYkpoY2hlaElHQXUxWG5KTm9aeDJmanJzTE14bUpmSjlmT2lLMzNHaEIK",
      "endpoints": [
        "https://gitee.com/xiaomaohuifaguang/Joker-Box-Web-New/releases/download/desktop/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
